  "query": "\n            UPDATE posts\n            SET \n                title = COALESCE($3, title),\n                content = COALESCE($4, content),\n                updated_at = NOW()\n            WHERE id = $1 AND author_id = $2\n            RETURNING id, title, content, author_id, created_at, updated_at\n            ",
